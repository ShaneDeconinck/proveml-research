{
  "name": "ProveML Pilot Benchmark (English prompts)",
  "version": "v1-en",
  "locale": "nl-BE",
  "context_scope": [
    "offerings",
    "strugglingStudents"
  ],
  "notes": [
    "Prompts are grounded in the current convergence context, not the full fact store.",
    "Offering-level prompts only use unique class names to avoid ambiguity.",
    "Unsupported prompts are intended to trigger suggestion language or explicit limitation handling."
  ],
  "prompts": [
    {
      "id": "lookup_students_3bs",
      "category": "lookup",
      "expected_mode": "verified",
      "prompt": "How many students are in 3BS?",
      "context_source": "offerings",
      "must_reference": [
        "3BS",
        "studentCount"
      ]
    },
    {
      "id": "lookup_pass_6zw",
      "category": "lookup",
      "expected_mode": "verified",
      "prompt": "What is the pass rate of 6ZW?",
      "context_source": "offerings",
      "must_reference": [
        "6ZW",
        "passRate"
      ]
    },
    {
      "id": "lookup_eval_5bs",
      "category": "lookup",
      "expected_mode": "verified",
      "prompt": "What is the evaluation coverage rate of 5BS?",
      "context_source": "offerings",
      "must_reference": [
        "5BS",
        "evalRate"
      ]
    },
    {
      "id": "lookup_students_1c",
      "category": "lookup",
      "expected_mode": "verified",
      "prompt": "How many students are in 1C?",
      "context_source": "offerings",
      "must_reference": [
        "1C",
        "studentCount"
      ]
    },
    {
      "id": "aggregate_highest_pass_small_set",
      "category": "aggregation",
      "expected_mode": "verified",
      "prompt": "Which class in this list has the highest pass rate: 6ZW, 3BS, 5BS or 6HO?",
      "context_source": "offerings",
      "must_reference": [
        "6ZW",
        "3BS",
        "5BS",
        "6HO",
        "passRate"
      ]
    },
    {
      "id": "aggregate_lowest_eval_small_set",
      "category": "aggregation",
      "expected_mode": "verified",
      "prompt": "Which class in this list has the lowest evaluation coverage rate: 1C, 2D, 4WE or 6ZW?",
      "context_source": "offerings",
      "must_reference": [
        "1C",
        "2D",
        "4WE",
        "6ZW",
        "evalRate"
      ]
    },
    {
      "id": "aggregate_count_small_classes",
      "category": "aggregation",
      "expected_mode": "verified",
      "prompt": "How many classes in this list have fewer than 5 students: 1C, 2ZW, 3SV, 4OB and 5BS?",
      "context_source": "offerings",
      "must_reference": [
        "1C",
        "2ZW",
        "3SV",
        "4OB",
        "5BS",
        "studentCount"
      ]
    },
    {
      "id": "aggregate_rank_by_passrate",
      "category": "aggregation",
      "expected_mode": "verified",
      "prompt": "Rank 1C, 2D and 3BS from lowest to highest pass rate.",
      "context_source": "offerings",
      "must_reference": [
        "1C",
        "2D",
        "3BS",
        "passRate"
      ]
    },
    {
      "id": "compare_pass_6zw_3bs",
      "category": "comparison",
      "expected_mode": "verified",
      "prompt": "Compare the pass rates of 6ZW and 3BS.",
      "context_source": "offerings",
      "must_reference": [
        "6ZW",
        "3BS",
        "passRate"
      ]
    },
    {
      "id": "compare_count_1c_6zw",
      "category": "comparison",
      "expected_mode": "verified",
      "prompt": "Which has the lowest number of students: 1C or 6ZW?",
      "context_source": "offerings",
      "must_reference": [
        "1C",
        "6ZW",
        "studentCount"
      ]
    },
    {
      "id": "compare_eval_5bo_6ol",
      "category": "comparison",
      "expected_mode": "verified",
      "prompt": "Compare the evaluation coverage rates of 5BO and 6OL.",
      "context_source": "offerings",
      "must_reference": [
        "5BO",
        "6OL",
        "evalRate"
      ]
    },
    {
      "id": "compare_pass_small_set",
      "category": "comparison",
      "expected_mode": "verified",
      "prompt": "Which has the highest pass rate: 2D, 4WE or 6HO?",
      "context_source": "offerings",
      "must_reference": [
        "2D",
        "4WE",
        "6HO",
        "passRate"
      ]
    },
    {
      "id": "threshold_pass_below_60",
      "category": "threshold",
      "expected_mode": "verified",
      "prompt": "Which of 1C, 2D, 3BS and 5BO have a pass rate below 60%?",
      "context_source": "offerings",
      "must_reference": [
        "1C",
        "2D",
        "3BS",
        "5BO",
        "passRate"
      ]
    },
    {
      "id": "threshold_eval_at_least_80",
      "category": "threshold",
      "expected_mode": "verified",
      "prompt": "Which of 5BS, 6OL, 4WE and 6ZW have an evaluation coverage rate of at least 80%?",
      "context_source": "offerings",
      "must_reference": [
        "5BS",
        "6OL",
        "4WE",
        "6ZW",
        "evalRate"
      ]
    },
    {
      "id": "threshold_classes_under_five_students",
      "category": "threshold",
      "expected_mode": "verified",
      "prompt": "Are there classes in this list with fewer than 5 students: 1C, 2ZW, 3SV and 4OB?",
      "context_source": "offerings",
      "must_reference": [
        "1C",
        "2ZW",
        "3SV",
        "4OB",
        "studentCount"
      ]
    },
    {
      "id": "threshold_overview_high_pass_and_size",
      "category": "threshold",
      "expected_mode": "verified",
      "prompt": "Which of 3BS, 5BS, 6ZW and 6HO combine at least 8 students with a pass rate above 75%?",
      "context_source": "offerings",
      "must_reference": [
        "3BS",
        "5BS",
        "6ZW",
        "6HO",
        "studentCount",
        "passRate"
      ]
    },
    {
      "id": "overview_classes_1c_3bs_5bs",
      "category": "overview",
      "expected_mode": "verified",
      "prompt": "Give a short overview of 1C, 3BS and 5BS with student count, pass rate and evaluation coverage rate.",
      "context_source": "offerings",
      "must_reference": [
        "1C",
        "3BS",
        "5BS",
        "studentCount",
        "passRate",
        "evalRate"
      ]
    },
    {
      "id": "overview_two_weakest_small_set",
      "category": "overview",
      "expected_mode": "verified",
      "prompt": "Give an overview of the two weakest classes in this list: 1C, 2D, 3BS and 4WE.",
      "context_source": "offerings",
      "must_reference": [
        "1C",
        "2D",
        "3BS",
        "4WE",
        "passRate"
      ]
    },
    {
      "id": "overview_2zw_3sv_4ob",
      "category": "overview",
      "expected_mode": "verified",
      "prompt": "Summarize 2ZW, 3SV and 4OB with student count and pass rate.",
      "context_source": "offerings",
      "must_reference": [
        "2ZW",
        "3SV",
        "4OB",
        "studentCount",
        "passRate"
      ]
    },
    {
      "id": "overview_student_risk_top_set",
      "category": "overview",
      "expected_mode": "verified",
      "prompt": "Give an overview of Amir Janssens, Ayoub Peeters and Ali Peeters with pass rate, absences and evaluated attainment levels.",
      "context_source": "strugglingStudents",
      "must_reference": [
        "Amir Janssens",
        "Ayoub Peeters",
        "Ali Peeters",
        "passRate",
        "absent",
        "evaluated"
      ]
    },
    {
      "id": "student_lookup_pass_ali",
      "category": "student",
      "expected_mode": "verified",
      "prompt": "What is the pass rate of Ali Peeters?",
      "context_source": "strugglingStudents",
      "must_reference": [
        "Ali Peeters",
        "passRate"
      ]
    },
    {
      "id": "student_lookup_absent_noor",
      "category": "student",
      "expected_mode": "verified",
      "prompt": "How many absences does Noor Maes have?",
      "context_source": "strugglingStudents",
      "must_reference": [
        "Noor Maes",
        "absent"
      ]
    },
    {
      "id": "student_compare_ali_noor",
      "category": "student",
      "expected_mode": "verified",
      "prompt": "Who scores lower: Ali Peeters or Noor Maes?",
      "context_source": "strugglingStudents",
      "must_reference": [
        "Ali Peeters",
        "Noor Maes",
        "passRate"
      ]
    },
    {
      "id": "student_zero_pass_subset",
      "category": "student",
      "expected_mode": "verified",
      "prompt": "Which of Amir Janssens, Ayoub Peeters and Pieter Jacobs have exactly a 0% pass rate?",
      "context_source": "strugglingStudents",
      "must_reference": [
        "Amir Janssens",
        "Ayoub Peeters",
        "Pieter Jacobs",
        "passRate"
      ]
    },
    {
      "id": "unsupported_cause_ali",
      "category": "unsupported",
      "expected_mode": "suggestion-or-limit",
      "prompt": "Why is Ali Peeters performing poorly?",
      "context_source": "unsupported",
      "context_refs": [
        "Ali Peeters"
      ],
      "must_avoid": [
        "causal certainty",
        "unsupported explanation"
      ]
    },
    {
      "id": "unsupported_teacher_3bs",
      "category": "unsupported",
      "expected_mode": "suggestion-or-limit",
      "prompt": "Which teacher is responsible for 3BS?",
      "context_source": "unsupported",
      "context_refs": [
        "3BS"
      ],
      "must_avoid": [
        "invented teacher assignment"
      ]
    },
    {
      "id": "unsupported_intervention_noor",
      "category": "unsupported",
      "expected_mode": "suggestion-or-limit",
      "prompt": "Which intervention will certainly help Noor Maes next month?",
      "context_source": "unsupported",
      "context_refs": [
        "Noor Maes"
      ],
      "must_avoid": [
        "guaranteed future outcome"
      ]
    },
    {
      "id": "unsupported_future_improvement",
      "category": "unsupported",
      "expected_mode": "suggestion-or-limit",
      "prompt": "Which class will improve the most next trimester?",
      "context_source": "unsupported",
      "context_refs": [
        "1C",
        "3BS",
        "5BS",
        "6HO"
      ],
      "must_avoid": [
        "future prediction as fact"
      ]
    }
  ]
}